//process next order (VIP first and then Regular)

void processNextOrder() {
    header("  KITCHEN - PROCESS NEXT ORDER  ");
    Order o;

    if (!priorityQueue.isEmpty()) {
        cout << "\n  [KITCHEN] Serving TOP PRIORITY order...\n";
        o = priorityQueue.dequeue();
    } else if (!regularQueue.isEmpty()) {
        cout << "\n  [KITCHEN] Serving next REGULAR order...\n";
        o = regularQueue.dequeue();
    } else {
        cout << "\n  [KITCHEN] No orders pending right now!\n";
        pressEnter();
        return;
    }

    o.status = "Served";
    cout << "  *** ORDER SERVED SUCCESSFULLY! ***\n";
    printReceipt(o);
    pressEnter();
}


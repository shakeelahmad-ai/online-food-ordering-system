//  HELPER: intToStr (replaces to_string for older compilers)

string intToStr(int n) {
    if (n == 0) return "0";
    string result = "";
    bool neg = false;
    if (n < 0) { neg = true; n = -n; }
    while (n > 0) {
        result = char('0' + n % 10) + result;
        n /= 10;
    }
    if (neg) result = "-" + result;
    return result;
}



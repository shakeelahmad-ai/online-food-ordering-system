            case 4: viewPendingOrders(); break;
            case 5: viewOrderHistory();  break;
            case 6: viewLastOrder();     break;
            case 7: viewStats();         break;
            case 8:
                displayMenu();
                pressEnter();
                break;
            case 0:
                cout << "\n+--------------------------------------------+\n";
                cout << "  |    Thank you for using S.FOODIES!          |\n";
                cout << "  |    Goodbye and come back soon!             |\n";
                cout << "  +--------------------------------------------+\n\n";
                break;
            default:
                cout << "\n  [!] Invalid choice. Try again.\n";
        }

    } while (choice != 0);

    return 0;
}

    if (priorityQueue.isEmpty()) {
        cout << "  (No VIP orders pending)\n";
    } else {
        int sz = priorityQueue.getSize();
        Order temp[MAX_PQ];
        for (int i = 0; i < sz; i++) temp[i] = priorityQueue.get(i);
        for (int i = 0; i < sz-1; i++)
            for (int j = i+1; j < sz; j++)

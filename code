void line(char c = '=', int w = 64) {
    cout << "  ";
    for (int i = 0; i < w; i++) cout << c;
    cout << "\n";
}

void header(const string& title) {
    cout << "\n";
    line('*', 62);
    int pad = (62 - (int)title.size()) / 2;
    cout << "  *" << string(pad - 1, ' ') << title
         << string(62 - 1 - pad - (int)title.size(), ' ') << "*\n";
    line('*', 62);
}

void sectionLine(const string& title) {
    cout << "\n  +--[ " << title << " ]";
    int rem = 55 - (int)title.size();
    if (rem < 0) rem = 0;
    for (int i = 0; i < rem; i++) cout << '-';
    cout << "+\n";
}


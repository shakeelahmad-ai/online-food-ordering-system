// building cart (multiple items)

int buildCart(CartItem items[], double& subtotal) {
    int  count = 0;
    subtotal   = 0.0;

    cout << "\n  [CART] You can add up to " << MAX_CART << " different items.\n";
    cout << "  Enter 0 as Item ID when done.\n";

    while (true) {
        if (count >= MAX_CART) {
            cout << "  [!] Cart is full.\n"; break;
        }

        displayMenu();

        int id;
        cout << "\n  Enter Item ID (0 = done): ";
        cin >> id;
        if (id == 0) break;

        int idx = findMenuItem(id);
        if (idx == -1) { cout << "  [!] Invalid ID. Try again.\n"; continue; }

        int qty;
        cout << "  Enter Quantity        : ";
        cin >> qty;
        if (qty <= 0) { cout << "  [!] Quantity must be >= 1.\n"; continue; }

        // If already in cart, update quantity
        bool merged = false;
        for (int i = 0; i < count; i++) {
            if (items[i].menuItemID == menu[idx].id) {
                items[i].quantity += qty;
                items[i].subtotal  = items[i].quantity * items[i].unitPrice;
                subtotal          += qty * menu[idx].price;
                cout << "  [+] Updated -> " << menu[idx].name
                     << " x" << items[i].quantity << "\n";
                merged = true;
                break;
            }
        }

        if (!merged) {
            items[count].menuItemID   = menu[idx].id;
            items[count].menuItemName = menu[idx].name;
            items[count].quantity     = qty;
            items[count].unitPrice    = menu[idx].price;
            items[count].subtotal     = qty * menu[idx].price;
            subtotal                 += items[count].subtotal;
            cout << "  [+] Added -> " << menu[idx].name
                 << " x" << qty << "  (Rs."
                 << fixed << setprecision(2) << items[count].subtotal << ")\n";
            count++;
        }

        // Show live cart
        cout << "\n  +-------------- Your Cart So Far -----+--------------\n";
        for (int i = 0; i < count; i++) {
            cout << "  | " << (i+1) << ". " << left << setw(22) << items[i].menuItemName
                 << " x" << items[i].quantity
                 << "  Rs." << fixed << setprecision(2) << items[i].subtotal << "\n";
        }
        cout << "  | " << right << setw(30) << "Subtotal: Rs."
             << fixed << setprecision(2) << subtotal << "\n";
        cout << "  +------------------------------------------------------+\n";

        if (count < MAX_CART) {
            char more;
            cout << "  Add more items? (y/n): ";
            cin >> more;
            if (more != 'y' && more != 'Y') break;
        }
    }
    return count;
}

//place Regular Order


void placeRegularOrder() {
    header("  PLACE REGULAR ORDER  ");

    string name, phone;
    cout << "\n  Enter Your Name  : ";
    cin.ignore();
    getline(cin, name);
    cout << "  Enter Phone No.  : ";
    getline(cin, phone);

    CartItem items[MAX_CART];
    double   subtotal = 0.0;
    int      count    = buildCart(items, subtotal);

    if (count == 0) {
        cout << "\n  [!] No items added. Order cancelled.\n";
        pressEnter();
        return;
    }

    Order o;
    o.orderID      = ++orderCounter;
    o.customerName = name;
    o.phone        = phone;
    o.itemCount    = count;
    o.subtotal     = subtotal;
    o.surcharge    = 0.0;
    o.totalPrice   = subtotal;
    o.priority     = 0;
    o.isVIP        = false;
    o.status       = "Pending";
    for (int i = 0; i < count; i++) o.items[i] = items[i];

    regularQueue.enqueue(o);
    orderHistory.push(o);

    cout << "\n  >> Added to REGULAR queue (FIFO - first come, first served)\n";
    printReceipt(o);
    pressEnter();
}


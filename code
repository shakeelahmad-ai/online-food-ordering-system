//  CLASS: Stack  (Order History - LIFO)

class Stack {
private:
    Order data[MAX_STACK];
    int   top;
public:
    Stack() : top(-1) {}

    bool  isEmpty()    { return top == -1; }
    bool  isFull()     { return top == MAX_STACK - 1; }
    int   size()       { return top + 1; }
    int   getTop()     { return top; }
    Order get(int i)   { return data[i]; }

    void push(Order o) {
        if (isFull()) { cout << "  [!] History stack full!\n"; return; }
        data[++top] = o;
    }

    Order pop() {
        if (isEmpty()) { Order e; e.orderID = -1; return e; }
        return data[top--];
    }

    Order peek() {
        if (isEmpty()) { Order e; e.orderID = -1; return e; }
        return data[top];
    }
};

//  CLASS: Queue  (Regular Orders - FIFO)

class Queue {
private:
    Order data[MAX_QUEUE];
    int   front, rear, count;
public:
    Queue() : front(0), rear(-1), count(0) {}

    bool  isEmpty()    { return count == 0; }
    bool  isFull()     { return count == MAX_QUEUE; }
    int   size()       { return count; }
    Order get(int i)   { return data[(front + i) % MAX_QUEUE]; }

    void enqueue(Order o) {
        if (isFull()) { cout << "  [!] Regular queue full!\n"; return; }
        rear = (rear + 1) % MAX_QUEUE;
        data[rear] = o;
        count++;
    }

    Order dequeue() {
        if (isEmpty()) { Order e; e.orderID = -1; return e; }
        Order o = data[front];
        front = (front + 1) % MAX_QUEUE;
        count--;
        return o;
    }
};

//  CLASS: PriorityQueue  (VIP Orders - Max-Heap)

class PriorityQueue {
private:
    Order data[MAX_PQ];
    int   sz;

    void heapifyUp(int i) {
        while (i > 0) {
            int p = (i - 1) / 2;
            if (data[p].priority < data[i].priority) { swap(data[p], data[i]); i = p; }
            else break;
        }
    }

    void heapifyDown(int i) {
        while (true) {
            int largest = i, l = 2*i+1, r = 2*i+2;
            if (l < sz && data[l].priority > data[largest].priority) largest = l;
            if (r < sz && data[r].priority > data[largest].priority) largest = r;
            if (largest != i) { swap(data[i], data[largest]); i = largest; }
            else break;
        }
    }

public:
    PriorityQueue() : sz(0) {}

    bool  isEmpty()    { return sz == 0; }
    bool  isFull()     { return sz == MAX_PQ; }
    int   getSize()    { return sz; }
    Order get(int i)   { return data[i]; }

    void enqueue(Order o) {
        if (isFull()) { cout << "  [!] Priority queue full!\n"; return; }
        data[sz] = o;
        heapifyUp(sz++);
    }

    Order dequeue() {
        if (isEmpty()) { Order e; e.orderID = -1; return e; }
        Order top = data[0];
        data[0] = data[--sz];
        heapifyDown(0);
        return top;
    }
};



